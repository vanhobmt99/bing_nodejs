{
    "sessionPath": "sessions",
    "headless": false,
    "clusters": 6,
    "rewardsMode": "browser",
    "errorDiagnostics": false,
    "ensureStreakProtection": true,
    "autoClaimPunchcardRewards": true,
    "continueOnBotWarning": true,
    "skipNonPointTasks": true,
    "accountDelay": {
        "min": "2min",
        "max": "4min"
    },
    "taskDelay": {
        "min": "15sec",
        "max": "28sec"
    },
    "workers": {
        "doDailySet": true,
        "doClaimBonusPoints": true,
        "doMorePromotions": true,
        "doPunchCards": true,
        "doAppPromotions": true,
        "doDesktopSearch": true,
        "doMobileSearch": true,
        "doBonusSearches": true,
        "doDailyCheckIn": true,
        "doReadToEarn": true,
        "doActivateSearchPerk": true,
        "doVisualSearch": true
    },
    "activities": {
        "urlReward": true,
        "searchOnBing": true
    },
    "searchOnBingLocalQueries": false,
    "globalTimeout": "45sec",
    "searchSettings": {
        "maxSearchOnBingAttempts": 3,
        "scrollRandomResults": true,
        "clickRandomResults": true,
        "runOnZeroPoints": false,
        "maxBonusSearches": 35,
        "parallelSearching": false,
        "clusterSearch": false,
        "useAccountLocale": true,
        "queryEngines": ["google", "wikipedia", "wikirandom", "reddit", "hackernews", "rss.googleNews", "local"],
        "searchResultVisitTime": "10sec",
        "searchDelay": {
            "min": "12sec",
            "max": "25sec"
        },
        "readDelay": {
            "min": "20s",
            "max": "30sec"
        }
    },
    "experimental": {
        "blockMedia": false,
        "edgeBrowsing": false,
        "browserSearchApiReport": false
    },
    "debugLogs": false,
    "consoleLogFilter": {
        "enabled": false,
        "mode": "whitelist",
        "levels": ["error", "warn"],
        "keywords": ["starting account", "Fraud_UserWarning_BotScore_UX"],
        "regexPatterns": []
    },
    "proxy": {
        "queryEngine": true,
        "ignoreCertificateErrors": false
    },
    "webhook": {
        "discord": {
            "enabled": false,
            "url": ""
        },
        "telegram": {
            "enabled": false,
            "botToken": "",
            "chatId": ""
        },
        "ntfy": {
            "enabled": false,
            "url": "",
            "topic": "",
            "token": "",
            "title": "Microsoft-Rewards-Script",
            "tags": ["bot", "notify"],
            "priority": 3
        },
        "webhookLogFilter": {
            "enabled": false,
            "mode": "whitelist",
            "levels": ["error"],
            "keywords": ["starting account", "select number", "collected", "Fraud_UserWarning_BotScore_UX"],
            "regexPatterns": []
