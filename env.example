# Account Credentials
# Copy this file to .env and fill in your details.
# .env should be in your .gitignore, never commit your credentials!
#
# Add one numbered block per account. Slots may be skipped; for example,
# ACCOUNT_2 can be used even when ACCOUNT_1 is not configured.
#
# LANG_CODE accepts a BCP 47 language tag such as nl, it, or pt-BR.
# GEO_LOCALE accepts a two-letter country code. With auto, the Microsoft
# profile country is cached after a successful dashboard request and used for
# later browser fingerprints and request headers.

# Account 1
ACCOUNT_1_EMAIL=email@example.com
# Optional. Leave unset for passwordless/Authenticator-only accounts.
#ACCOUNT_1_PASSWORD=your_password
#ACCOUNT_1_TOTP_SECRET=
#ACCOUNT_1_RECOVERY_EMAIL=
#ACCOUNT_1_GEO_LOCALE=auto
#ACCOUNT_1_LANG_CODE=en
# Browser proxy: HTTP/HTTPS/SOCKS4/SOCKS5. SOCKS proxies must not require authentication.
#ACCOUNT_1_PROXY_HTTP=false
#ACCOUNT_1_PROXY_URL=
#ACCOUNT_1_PROXY_PORT=0
#ACCOUNT_1_PROXY_USERNAME=
#ACCOUNT_1_PROXY_PASSWORD=
#ACCOUNT_1_SAVE_FINGERPRINT_MOBILE=false
#ACCOUNT_1_SAVE_FINGERPRINT_DESKTOP=false

# Account 2 (duplicate and use any positive slot number for more accounts)
#ACCOUNT_2_EMAIL=email_2@example.com
#ACCOUNT_2_PASSWORD=your_password
#ACCOUNT_2_TOTP_SECRET=
#ACCOUNT_2_RECOVERY_EMAIL=
#ACCOUNT_2_GEO_LOCALE=auto
#ACCOUNT_2_LANG_CODE=en
#ACCOUNT_2_PROXY_HTTP=false
#ACCOUNT_2_PROXY_URL=
#ACCOUNT_2_PROXY_PORT=0
#ACCOUNT_2_PROXY_USERNAME=
#ACCOUNT_2_PROXY_PASSWORD=

# Optional overrides for the task and Explore on Bing settings in config.json.
#CONFIG_TASK_DELAY_MIN=15sec
#CONFIG_TASK_DELAY_MAX=30sec
#CONFIG_SEARCH_ON_BING_MAX_ATTEMPTS=3

# Control API (npm run api, or API_MODE=true in compose.yaml)
# Setup, endpoint reference and examples: docs/control-api.md.
# Generate a token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#API_TOKEN=

# Grafana account dashboard: docs/monitoring.md.
# Required when using compose.monitoring.yaml; choose a strong administrator password.
#GRAFANA_ADMIN_PASSWORD=
#GRAFANA_ADMIN_USER=admin
#GRAFANA_PORT=3000

# Grafana Cloud: use compose.grafana-cloud.yaml instead of compose.monitoring.yaml.
# Values are available under Grafana Cloud > Connections > Add new connection > Hosted Prometheus.
#GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-REGION.grafana.net/api/prom/push
#GRAFANA_CLOUD_PROMETHEUS_USERNAME=123456
# Cloud Access Policy token scoped to metrics:write for your stack.
#GRAFANA_CLOUD_METRICS_TOKEN=
# Unique label for this installation; use different values for different servers.
#GRAFANA_CLOUD_DEPLOYMENT=rewards

# Optional dashboard installation: npm run monitoring:cloud:dashboard
# This is a Grafana service account token, separate from the metrics:write token above.
#GRAFANA_CLOUD_URL=https://your-stack.grafana.net
#GRAFANA_CLOUD_SERVICE_ACCOUNT_TOKEN=
# UID of your Cloud Prometheus data source, often grafanacloud-STACK-prom.
#GRAFANA_CLOUD_PROMETHEUS_DATASOURCE_UID=

# Search diagnostics in Grafana Cloud (add compose.grafana-cloud-logs.yaml).
# Hosted Loki connection details; the token requires logs:write scope.
#GRAFANA_CLOUD_LOKI_URL=https://logs-prod-REGION.grafana.net/loki/api/v1/push
#GRAFANA_CLOUD_LOKI_USERNAME=123456
#GRAFANA_CLOUD_LOGS_TOKEN=
# Dashboard installation: npm run monitoring:cloud:logs-dashboard
#GRAFANA_CLOUD_LOKI_DATASOURCE_UID=

# Continue despite an explicit Microsoft bot warning (default: false).
#CONFIG_CONTINUE_ON_BOT_WARNING=false
# Read to Earn follows rewardsMode: API directly, or browser first with API fallback.
#CONFIG_WORKER_READ_TO_EARN=true

# Query sources: true derives language from the account country; false uses English/US.
#CONFIG_SEARCH_USE_ACCOUNT_LOCALE=true

# Experimental: send one API search per account after browser work (default: false).
#CONFIG_EXPERIMENTAL_BROWSER_SEARCH_API_REPORT=false
